SPREADSHEET_ID=1cKZXaMyv0vIua3-mWyL5IRNiSnCb7HHYCyqsTFNiubg
ALLOWED_ALICE_USER_IDS=alice-user-id-here
RUN_HTTP_SERVER=1
PORT=8080
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Random high-entropy secret. Set in Yandex Cloud Function environment.
# Add ?key=<same-secret> to the Dialogs webhook URL. Never commit real value.
ALICE_WEBHOOK_SECRET=replace-with-random-64-hex-characters

# Optional Gemini parser (OFF by default; never put a real key in Git)
AI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=configure-only-in-Yandex-Cloud-secret-environment
